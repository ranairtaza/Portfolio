# ==============================================================================
# RANA.OS Environment Configuration & Setup Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Contact Email Configuration (Client-Visible)
# ------------------------------------------------------------------------------
# Set this to your verified, real email address.
# In accordance with strict portfolio integrity standards, direct email actions
# (e.g., mailto links, copy-to-clipboard email actions) remain hidden in the UI
# until a verified address is provided here or directly in src/data/portfolio.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# 2. Résumé Asset Configuration
# ------------------------------------------------------------------------------
# Place your real, verified résumé PDF into the public/ directory:
#   Path: public/resume.pdf
#
# When your real résumé file is in place, set this flag to "true":
#   NEXT_PUBLIC_HAS_RESUME=true
#
# If no real résumé file exists, leave this empty or "false". The UI download action
# remains completely hidden to prevent linking to nonexistent or placeholder files.
NEXT_PUBLIC_HAS_RESUME=false

# ------------------------------------------------------------------------------
# 3. Contact Form Automated Dispatch (Server-Side Only - Secrets)
# ------------------------------------------------------------------------------
# RANA.OS includes a robust contact form with client-side validation, accessible
# error states, honeypot spam protection, and rate limiting at /api/contact.
#
# If no email provider is configured below, the contact form transparently activates
# its fallback mode: it never claims "Message sent" falsely, and instead offers
# one-click Google Calendar booking, inquiry payload copying, and prefilled mailto.
#
# To enable real server-side email dispatch, provide credentials from an email service
# such as Resend (https://resend.com):
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=

# ------------------------------------------------------------------------------
# 4. Canonical Site URL & SEO Domain Configuration (Optional)
# ------------------------------------------------------------------------------
# Set this to your custom production domain (e.g., https://yourdomain.com).
# If omitted during deployment on Vercel, RANA.OS automatically reads
# VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL so canonical tags, sitemaps,
# and OpenGraph metadata dynamically match your real deployment domain.
NEXT_PUBLIC_SITE_URL=
